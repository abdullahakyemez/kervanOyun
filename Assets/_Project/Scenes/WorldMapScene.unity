--- !u!114 &854301732
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 854301730}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1fe15b3f17872f44cbc25c585b2c87f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Kervan.Runtime::Kervan.UI.StoryIntroUI
  _introPanel: {fileID: 854301730}
  _backgroundImage: {fileID: 854301733}
  _characterNameText: {fileID: 1482755965}
  _dialogueText: {fileID: 1945961447}
  _characterPortrait: {fileID: 689066192}
  _nextButton: {fileID: 1794447433}
  _dialogues:
  - characterName: "Sad\u0131k Muhaf\u0131z"
    dialogueText: "Katalan bask\u0131n\u0131nda her \u015Feyimizi kaybettik beyim... S\xF6\u011F\xFCt Kad\u0131s\u0131na 2000 ak\xE7e borcumuz var."
    characterSprite: {fileID: 21300000, guid: 85e09433cab7b234fb5c29a5cf6d59f3, type: 3}
    isRightSide: 1
  - characterName: Ahi (Oyuncu)
    dialogueText: "Biliyorum yolda\u015F. Elimizde sadece bu kat\u0131r ve inanc\u0131m\u0131z kald\u0131. Bu borcu 30 g\xFCn i\xE7inde \xF6demezsek kervan\u0131m\u0131z\u0131 tamamen kaybedece\u011Fiz."
    characterSprite: {fileID: 21300000, guid: c46640b0145fd7a4a8678dde2f985059, type: 3}
    isRightSide: 0
  - characterName: "Sad\u0131k Muhaf\u0131z"
    dialogueText: "O halde vakit kaybetmeden ticarete ba\u015Flayal\u0131m. \u015E\x9Eehirlerden ucuz mal al\u0131p, ihtiyac\u0131 olan yerlerde satmal\u0131y\u0131z. Yoksa sonumuz vahimdir..."
    characterSprite: {fileID: 21300000, guid: 85e09433cab7b234fb5c29a5cf6d59f3, type: 3}
    isRightSide: 1
  - characterName: Ahi (Oyuncu)
    dialogueText: "S\xF6\u011F\xFCt'ten \xE7\u0131k\u0131p yollara d\xFC\u015Fme vakti geldi. Uc beyli\u011Finde kendi itibar\u0131m\u0131z\u0131 yeniden kazanaca\u011F\u0131z. Allah utand\u0131rmas\u0131n!"
    characterSprite: {fileID: 21300000, guid: c46640b0145fd7a4a8678dde2f985059, type: 3}
    isRightSide: 0
  - characterName: Sistem Bilgisi
    dialogueText: "Ho\u015F geldin... Arkanda g\xF6rd\xFC\u011F\xFCn bu harita senin oyun alan\u0131n. \xC5\u015Eehirlerde ticaret yap, hanlarda dinlen ve g\xF6revler al."
    characterSprite: {fileID: 0}
    isRightSide: 0
  - characterName: Sistem Bilgisi
    dialogueText: "Yola \xE7\u0131kkmadan \xF6nce erzak ve adamlar\u0131n\u0131 kontrol etmeyi unutma. Sefere \xE7\u0131kmaya haz\u0131rsan, ilk hedefine t\u0131kla!"
    characterSprite: {fileID: 0}
    isRightSide: 0
  - characterName: Sistem Bilgisi
    dialogueText: "\u0130LK G\xD6REV: 30 g\xFCn i\xE7inde 2000 Ak\xE7e kazan\u0131p borcunu \xF6de. Haritada ticaret yapmak istedi\u011Fin \u015Fehre veya hana t\u0131kla."
    characterSprite: {fileID: 0}
    isRightSide: 0
